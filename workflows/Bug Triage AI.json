    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\nconst title = String(body.title ?? '').trim();\nconst description = String(body.description ?? '').trim();\nconst reporter = String(body.reporter ?? 'unknown').trim();\n\nconst errors = [];\nif (!title) errors.push('title is required');\nelse if (title.length > 150) errors.push('title too long (max 150)');\nif (!description) errors.push('description is required');\nelse if (description.length < 10) errors.push('description too short (min 10 chars)');\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    title,\n    description: description.slice(0, 2000),\n    reporter,\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "69963588-1e6b-4be5-b2be-374219aa3f5d",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -688,
        160
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "fed2e633-69d3-4abc-a181-a0881aab63eb",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
